{
  "name": "olxba-laptop-ranker",
  "version": "2.0.0",
  "description": "Local OLX.ba laptop discovery and deterministic ranking app",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "olx-laptops": "bin/cli.js"
  },
  "scripts": {
    "start": "node --no-warnings bin/cli.js serve",
    "crawl": "node --no-warnings bin/cli.js crawl",
    "enrich": "node --no-warnings bin/cli.js enrich",
    "export": "node --no-warnings bin/cli.js export",
    "smoke": "node --no-warnings bin/cli.js crawl --max-pages 2",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
